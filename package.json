{
  "homepage": "",
  "name": "parsa-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "dev": "vite",
    "build": "rm -rf dist && vite build && sed -i.bak -E 's#\"/old/(site-header\\.js|favicon\\.ico|favicon-32\\.png|apple-touch-icon\\.png)\"#\"/\\1\"#g' dist/old/index.html && rm -f dist/old/index.html.bak && cp -R public/. dist/ && npm run check:i18n && astro build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:new": "astro dev",
    "check:i18n": "node tools/check-i18n.mjs"
  },
  "dependencies": {
    "@fontsource/inter-tight": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "react": "^18.3.1",
    "react-anchor-link-smooth-scroll": "^1.0.12",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "astro": "7.3.5",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "gh-pages": "^6.1.1",
    "globals": "^15.9.0",
    "serve": "^14.2.4",
    "vite": "^7.3.0",
    "vite-imagetools": "^9.0.0"
  }
}
