---
// Home page — /  (English) and /de/ (German)
import Base from '../../layouts/Base.astro';
import Hero from '../../components/home/Hero.astro';
import Partners from '../../components/home/Partners.astro';
import Work from '../../components/home/Work.astro';
import About from '../../components/home/About.astro';
import Services from '../../components/home/Services.astro';
import Testimonials from '../../components/home/Testimonials.astro';
import Posts from '../../components/home/Posts.astro';
import Contact from '../../components/home/Contact.astro';
import Footer from '../../components/home/Footer.astro';
import { type Lang, ui } from '../../lib/i18n';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'de' } }];
}
const lang: Lang = Astro.params.lang === 'de' ? 'de' : 'en';
const t = ui(lang);
---
<Base lang={lang} title={t.meta.homeTitle} description={t.meta.homeDescription} ogImage="home" ogAlt={t.meta.homeImageAlt}>
  <script is:inline slot="head">if (location.hash.indexOf('#/') === 0) location.replace('/old/' + location.hash);</script>
  <main>
    <Hero lang={lang} />
    <Partners lang={lang} />
    <Work lang={lang} />
    <About lang={lang} />
    <Services lang={lang} />
    <Testimonials lang={lang} />
    <Posts lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
