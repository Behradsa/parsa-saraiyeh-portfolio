---
// Case-study pages — /carriot, /de/carriot … The text and pictures for each one are in
// site/src/i18n/<lang>/cases/<slug>.json; this file only lays them out.
import Base from '../../layouts/Base.astro';
import Figure from '../../components/case/Figure.astro';
import { type Lang, ui, caseStudy, nextCase, url, site, fill } from '../../lib/i18n';

export function getStaticPaths() {
  return site.cases.flatMap((slug) => [
    { params: { lang: undefined, slug } },
    { params: { lang: 'de', slug } },
  ]);
}
const lang: Lang = Astro.params.lang === 'de' ? 'de' : 'en';
const slug = Astro.params.slug as string;
const t = ui(lang);
const c = caseStudy(lang, slug);
const next = nextCase(slug);
const decisionCols = c.decisions.items.length === 4 ? 2 : 3;
---
<Base
  lang={lang}
  page={slug}
  title={fill(t.meta.caseTitle, { name: c.name })}
  shareTitle={fill(t.meta.caseShareTitle, { name: c.name })}
  description={c.lede}
  ogImage={slug}
  ogAlt={fill(t.meta.caseImageAlt, { name: c.name })}
  headerLabel={c.label}
>
  <main class="case">
    <!-- title -->
    <section class="intro wrap">
      <a class="back" href={url(lang, '', 'work')}>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M9.5 3.5L5 8l4.5 4.5" /></svg>
        {t.allProjects}
      </a>
      <span class="eyebrow"><span class="dot"></span>{t.caseStudy}</span>
      <div class="intro-grid">
        <h1>{c.title}</h1>
        <p class="lede">{c.lede}</p>
      </div>
    </section>

    <!-- hero picture -->
    <section class="hero wrap">
      <div class="hero-box">
        <img class="hero-img" src={c.hero.src} alt={c.hero.alt} style={c.hero.pos ? `object-position: ${c.hero.pos}` : undefined} fetchpriority="high" />
        <span class="hero-tag"><span class="dot"></span>{c.hero.tag}</span>
      </div>
    </section>

    <!-- when / role / team / scope / live -->
    <section class="meta wrap">
      <dl class="meta-grid" style={`--n: ${c.meta.length}`}>
        {c.meta.map((m: any) => (
          <div>
            <dt class="mono">{m.label}</dt>
            <dd>
              {m.link ? (
                <a class="live" href={m.link.href} target="_blank" rel="noopener">{m.link.text}
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M5.5 10.5l5-5M6.5 5.5h4.5v4.5" /></svg>
                </a>
              ) : m.text}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    {c.feature && (
      <section class="feature-sec wrap">
        <a class="feature rvu" href={c.feature.href} target="_blank" rel="noopener">
          <img src={c.feature.image.src} alt={c.feature.image.alt} loading="lazy" />
          <span class="f-text">
            <span class="eyebrow on-dark"><span class="dot"></span>{c.feature.label}</span>
            <span class="f-title">{c.feature.title}</span>
            <span class="f-sub">{c.feature.text}</span>
          </span>
          <span class="pill pill-light f-cta">{c.feature.cta}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
          </span>
        </a>
      </section>
    )}

    <!-- the problem -->
    <section class="problem wrap">
      <span class="eyebrow"><span class="dot"></span>{c.problem.label}</span>
      <div class="p-body">
        <h2 class="rvh">{c.problem.title}</h2>
        <div class="p-cols">
          {c.problem.paragraphs.map((p: string, i: number) => <p class="rvu" style={`--d: ${80 + i * 90}ms`}>{p}</p>)}
        </div>
      </div>
    </section>

    <!-- key decisions -->
    <section class="decisions wrap">
      <h2 class="rvh">{c.decisions.title}</h2>
      <ol class="d-grid" style={`--cols: ${decisionCols}`}>
        {c.decisions.items.map((d: any, i: number) => (
          <li class="d-card rvu" style={`--d: ${(i % decisionCols) * 90}ms`}>
            <span class="num" aria-hidden="true">{i + 1}</span>
            <h3>{d.title}</h3>
            <p>{d.text}</p>
            {d.cost && <span class="cost"><span class="mono">{c.decisions.costLabel}</span> {d.cost}</span>}
          </li>
        ))}
      </ol>
    </section>

    <!-- the work -->
    <section class="work wrap">
      <div class="w-head">
        <h2 class="rvh">{c.work.title}</h2>
        <span class="mono">{c.work.note}</span>
      </div>
      {c.work.groups.map((g: any) => (
        <div class="group">
          <div class="g-head">
            <span class="dot" aria-hidden="true"></span>
            <h3 class="rvh">{g.title}</h3>
            <span class="g-sub">{g.sub}</span>
          </div>
          {g.blocks.map((b: any) => (
            <div class:list={['block', { labelled: b.label }]}>
              {b.label && <span class="mono b-label">{b.label}</span>}
              {b.type === 'grid' ? (
                <div class="b-grid" style={`--cols: ${b.cols}`} data-cols={b.cols}>
                  {b.items.map((it: any, i: number) => <Figure item={it} delay={Math.min(i, 4) * 110} />)}
                </div>
              ) : (
                <Figure item={b} />
              )}
            </div>
          ))}
        </div>
      ))}
      {(c.work.after ?? []).map((b: any) => <div class="block after"><Figure item={b} /></div>)}
    </section>

    <!-- outcome -->
    <section class="outcome wrap">
      <div class="o-card rvu">
        <div class="o-top">
          <span class="eyebrow on-dark"><span class="dot"></span>{c.outcome.label}</span>
          <p class="o-title">{c.outcome.title}</p>
        </div>
        <div class="o-bottom">
          <p>{c.outcome.text}</p>
          <a class="pill pill-light" href={c.outcome.cta.href} target="_blank" rel="noopener">{c.outcome.cta.text}<span class="dot" aria-hidden="true"></span></a>
        </div>
      </div>
    </section>

    <!-- next project -->
    <section class="next wrap">
      <a class="next-link" href={url(lang, next)}>
        <span class="n-text">
          <span class="mono">{t.nextProject}</span>
          <span class="n-title">{c.next.title}</span>
        </span>
        <span class="n-go" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1"><path d="M4 10h12M11 5l5 5-5 5" /></svg>
        </span>
      </a>
    </section>
  </main>
  <footer class="c-foot wrap">
    <span>{t.footer.copyright} · {t.footer.domain}</span>
    <nav>
      <a href={url(lang, '', 'work')}>{t.nav.projects}</a>
      <a href={url(lang, '', 'contact')}>{t.nav.contact}</a>
      <a href={site.cv} target="_blank" rel="noopener">{t.nav.resume}</a>
    </nav>
  </footer>
</Base>

<style>
  /* ---- title ---- */
  /* desktop sections keep the spacing of the design: each one is at least as tall as it was drawn */
  .intro { padding-top: calc(72 * var(--u)); padding-bottom: 40px; min-height: calc(360 * var(--u)); display: flex; flex-direction: column; gap: 24px; }
  .back { align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: var(--text); }
  .back:hover { color: var(--ink); }
  .intro-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px; align-items: end; }
  h1 { grid-column: span 4; font-size: calc(88 * var(--u)); line-height: 0.92; font-weight: 700; letter-spacing: -0.035em; }
  .lede { grid-column: span 8; max-width: 680px; font-size: calc(34 * var(--u)); line-height: 1.15; font-weight: 600; letter-spacing: -0.02em; }

  /* ---- hero ---- */
  .hero { padding-top: 0; }
  .hero { min-height: calc(560 * var(--u)); }
  .hero-box { position: relative; height: calc(520 * var(--u)); border-radius: 32px; overflow: hidden; }
  .hero-img { width: 100%; height: 100%; object-fit: cover; scale: 1.1; will-change: transform; }
  .hero-tag { position: absolute; left: 20px; bottom: 20px; display: inline-flex; align-items: center; gap: 12px; background: var(--white); border-radius: 999px; padding: 8px 16px; box-shadow: 0 2px 10px rgba(10, 10, 10, 0.12); font-size: 13px; font-weight: 600; letter-spacing: -0.005em; }

  /* ---- meta ---- */
  .meta { padding-top: calc(64 * var(--u)); min-height: calc(230 * var(--u)); }
  .meta-grid { margin: 0; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 24px; padding-top: 24px; border-top: 1px solid var(--line); }
  .meta-grid > div { display: flex; flex-direction: column; gap: 8px; }
  dd { margin: 0; font-size: 15px; line-height: 1.55; }
  .live { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; }

  /* ---- Snapp!Trip guideline card ---- */
  .feature-sec { padding-top: calc(64 * var(--u)); }
  .feature { display: flex; align-items: center; gap: 32px; padding: 20px; background: var(--ink); border-radius: 24px; overflow: hidden; color: var(--on-dark); }
  .feature:hover { color: var(--on-dark); }
  .feature img { width: 320px; flex-shrink: 0; border-radius: 16px; }
  .f-text { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
  .f-title { font-size: 24px; line-height: 1.25; font-weight: 600; letter-spacing: -0.015em; }
  .f-sub { font-size: 13px; line-height: 1.5; color: var(--on-dark-2); }
  .f-cta { flex-shrink: 0; padding: 15px 20px; }
  .f-cta svg { transition: transform .45s var(--ease-out); }
  .feature:hover .f-cta svg { transform: translateX(4px); }

  /* ---- problem ---- */
  .problem { padding-top: calc(96 * var(--u)); min-height: calc(400 * var(--u)); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px; align-items: start; }
  .problem > .eyebrow { grid-column: span 4; padding-top: 8px; }
  .p-body { grid-column: span 8; display: flex; flex-direction: column; gap: 24px; }
  .p-body h2 { max-width: 680px; font-size: calc(34 * var(--u)); line-height: 1.15; font-weight: 600; letter-spacing: -0.02em; color: var(--ink); }
  .p-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; }
  .p-cols p { font-size: 15px; line-height: 1.55; color: var(--text); }

  /* ---- decisions ---- */
  .decisions { padding-top: calc(96 * var(--u)); }
  .decisions > h2, .w-head h2 { font-size: 40px; line-height: 1; font-weight: 700; letter-spacing: -0.02em; color: var(--ink); }
  .decisions > h2 { margin-bottom: 40px; }
  .d-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 24px; }
  .d-card { min-height: 360px; background: var(--white); border: 1px solid var(--card-line); border-radius: 24px; padding: 32px; display: flex; flex-direction: column; gap: 16px; }
  .num { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 999px; background: var(--accent); font-size: 19px; font-weight: 700; color: var(--white); }
  .d-card h3 { font-size: 24px; line-height: 1.25; font-weight: 600; letter-spacing: -0.015em; }
  .d-card p { font-size: 15px; line-height: 1.55; color: var(--text); }
  .cost { margin-top: auto; padding-top: 16px; border-top: 1px solid var(--card-line); font-size: 13px; line-height: 1.5; color: var(--muted); }

  /* ---- the work ---- */
  .work { padding-top: calc(96 * var(--u)); }
  .w-head { min-height: 100px; display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; }
  .w-head .mono { padding-top: 12px; }
  .group + .group { margin-top: 64px; }
  .g-head { display: flex; align-items: baseline; gap: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
  .g-head .dot { align-self: center; }
  .g-head h3 { font-size: 24px; line-height: 1.25; font-weight: 600; letter-spacing: -0.015em; color: var(--ink); }
  .g-sub { font-size: 13px; line-height: 1.5; color: var(--muted); }
  .block { margin-top: 24px; }
  .block:first-of-type, .g-head + .block { margin-top: 20px; }
  .block.labelled + .block.labelled { margin-top: 40px; }
  .g-head + .block.labelled { margin-top: 24px; }
  .b-label { display: block; margin-bottom: 8px; }
  .b-grid { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 24px; }
  .after { margin-top: 64px; }

  /* ---- outcome ---- */
  .outcome { padding-top: calc(96 * var(--u)); }
  .o-card { min-height: 424px; background: var(--ink); border-radius: 32px; padding: 48px; display: flex; flex-direction: column; justify-content: space-between; gap: 40px; color: var(--on-dark); }
  .o-top { display: flex; flex-direction: column; gap: 20px; }
  .o-title { max-width: 900px; font-size: calc(56 * var(--u)); line-height: 0.96; font-weight: 700; letter-spacing: -0.03em; }
  .o-bottom { display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; padding-top: 24px; border-top: 1px solid var(--on-dark-line); }
  .o-bottom p { max-width: 680px; font-size: 15px; line-height: 1.55; color: var(--on-dark-2); }
  .o-bottom .pill { flex-shrink: 0; }

  /* ---- next project + footer ---- */
  .next { padding-top: 80px; }
  .next-link { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-bottom: 32px; border-bottom: 1px solid var(--line); color: var(--ink); }
  .next-link:hover { color: var(--ink); }
  .n-text { display: flex; flex-direction: column; gap: 8px; }
  .n-title { font-size: calc(56 * var(--u)); line-height: 0.96; font-weight: 700; letter-spacing: -0.03em; }
  .n-go { display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; flex-shrink: 0; border-radius: 999px; background: var(--ink); color: var(--on-dark); transition: transform .45s var(--ease-out), background-color .3s ease; }
  .next-link:hover .n-go { transform: translateX(8px); background-color: var(--accent); }
  .c-foot { height: 72px; margin-top: 120px; margin-bottom: 40px; display: flex; align-items: center; justify-content: space-between; gap: 16px; font-size: 13px; color: var(--muted); }
  .c-foot nav { display: flex; gap: 24px; }
  .c-foot a { color: var(--muted); }
  .c-foot a:hover { color: var(--ink); }

  /* ---- between 820 and 1100: fewer columns ---- */
  @media (min-width: 820px) and (max-width: 1100px) {
    .meta-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .d-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .b-grid[data-cols='5'] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .b-grid[data-cols='4'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    h1 { grid-column: span 5; }
    .lede { grid-column: span 7; }
  }

  /* ---- phones ---- */
  @media (max-width: 819px) {
    .intro, .hero, .meta, .problem { min-height: 0; }
    .intro { padding-top: 32px; }
    .intro-grid { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
    h1 { font-size: 44px; line-height: 0.98; }
    .lede { font-size: 26px; }
    .hero { padding-top: 32px; }
    .hero-box { height: auto; border-radius: 24px; }
    .hero-img { height: auto; }
    .meta { padding-top: 48px; }
    .meta-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 16px; }
    .meta-grid > div:last-child:nth-child(odd) { grid-column: span 2; }
    .feature-sec { padding-top: 48px; }
    .feature { flex-direction: column; align-items: stretch; gap: 16px; }
    .feature img { width: 100%; }
    .f-title { font-size: 20px; }
    .f-cta { align-self: flex-start; }
    .problem { padding-top: 48px; display: flex; flex-direction: column; gap: 20px; }
    .problem > .eyebrow { padding-top: 0; }
    .p-body { gap: 20px; }
    .p-body h2 { font-size: 26px; }
    .p-cols { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .decisions, .work, .outcome { padding-top: 48px; }
    .decisions > h2, .w-head h2 { font-size: 26px; line-height: 1.15; }
    .decisions > h2 { margin-bottom: 20px; }
    .d-grid { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .d-card { min-height: 0; padding: 24px; }
    .d-card h3 { font-size: 20px; }
    .w-head { min-height: 0; flex-direction: column; gap: 8px; margin-bottom: 24px; }
    .w-head .mono { padding-top: 0; }
    .g-head { flex-wrap: wrap; row-gap: 4px; }
    .g-head h3 { font-size: 20px; }
    .g-sub { flex-basis: 100%; }
    .group + .group { margin-top: 48px; }
    .b-grid { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .b-grid[data-cols='4'], .b-grid[data-cols='5'], .b-grid[data-cols='6'] { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .after { margin-top: 48px; }
    .o-card { min-height: 0; padding: 24px; border-radius: 24px; gap: 32px; }
    .o-title { font-size: 44px; line-height: 0.98; }
    .o-bottom { flex-direction: column; align-items: flex-start; gap: 20px; }
    .next { padding-top: 48px; }
    .n-title { font-size: 44px; line-height: 0.98; }
    .c-foot { height: auto; margin: 32px 0 32px; flex-direction: column; align-items: flex-start; gap: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-img { scale: 1; }
    .n-go, .f-cta svg { transition: none; }
  }
</style>

<script>
  import { reduceMotion, clamp, onScrollFrame } from '../../scripts/motion';
  // the title picture drifts down a little as the page scrolls
  const img = document.querySelector<HTMLElement>('.hero-img');
  if (img && !reduceMotion()) onScrollFrame(() => { img.style.translate = `0 ${clamp(scrollY * 0.12, 0, 48).toFixed(1)}px`; });
</script>
