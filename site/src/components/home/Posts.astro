---
// Latest LinkedIn posts (LinkedIn's own embeds).
import Roll from '../Roll.astro';
import { type Lang, home, site } from '../../lib/i18n';
interface Props { lang: Lang }
const p = home(Astro.props.lang).posts;
---
<section id="posts" class="posts wrap">
  <div class="head">
    <div class="titles">
      <span class="eyebrow"><span class="dot"></span>{p.label}</span>
      <h2 class="rvh">{p.title}</h2>
    </div>
    <a class="pill pill-dark" href={site.linkedinActivity} target="_blank" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><rect x="3" y="3" width="14" height="14" rx="3" /><path d="M6.5 8.5v5M6.5 6.2v.1M10 13.5v-3a1.8 1.8 0 0 1 3.5 0v3" /></svg>
      <Roll text={p.all} />
      <span class="dot" aria-hidden="true"></span>
    </a>
  </div>
  <div class="grid">
    {p.items.map((urn, i) => (
      <div class="post rvu" style={`--d: ${i * 90}ms`}>
        <iframe loading="lazy" src={`https://www.linkedin.com/embed/feed/update/${urn}?collapsed=1`} title={p.embedTitle} allowfullscreen></iframe>
      </div>
    ))}
  </div>
</section>

<style>
  .posts { padding-top: calc(128 * var(--u)); display: flex; flex-direction: column; gap: 48px; }
  .head { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; }
  .titles { display: flex; flex-direction: column; gap: 20px; }
  h2 { font-size: 40px; line-height: 1.05; font-weight: 700; letter-spacing: -0.03em; color: var(--ink); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; align-items: start; }
  .post { border-radius: 16px; overflow: hidden; border: 1px solid var(--card-line); background: var(--white); }
  iframe { display: block; width: 100%; height: 640px; border: 0; }
  @media (max-width: 819px) {
    .posts { padding-top: 64px; gap: 24px; }
    .head { flex-direction: column; align-items: flex-start; gap: 16px; }
    .titles { gap: 16px; }
    .grid { display: flex; flex-direction: column; gap: 24px; }
    iframe { height: 600px; }
  }
</style>
