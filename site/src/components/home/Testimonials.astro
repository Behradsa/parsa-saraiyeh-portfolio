---
// Testimonials, the three measured results with bars, and the big numbers underneath.
import Counter from '../Counter.astro';
import { type Lang, home } from '../../lib/i18n';
interface Props { lang: Lang }
const t = home(Astro.props.lang).testimonials;
// A featured quote (dark card with a portrait) can be added in the text files as "featured":
// { "quote", "name", "role", "photo", "rating" }. Without it the two quotes take its place.
const featured = t.featured as null | { quote: string; name: string; role: string; photo: string; rating?: string };
---
<section class="testimonials wrap">
  <span class="eyebrow"><span class="dot"></span>{t.label}</span>

  <div class:list={['grid', { 'no-featured': !featured }]}>
    <div class="metrics">
      <h2 class="rvh">{t.title}</h2>
      <span class="measured">{t.measured}</span>
      {t.metrics.map((m) => (
        <div class="metric">
          <Counter value={m.value} suffix={m.suffix} size="small" />
          <span class="m-text">{m.text}</span>
          <span class="bar rv-watch"><span class="bar-f" style={`width: ${m.value}%`}></span></span>
        </div>
      ))}
    </div>

    {featured && (
      <figure class="featured rvu">
        <img class="portrait" src={featured.photo} alt="" loading="lazy" />
        <div class="f-body">
          {featured.rating && (
            <div class="stars" aria-label={`${featured.rating} / 5`}>
              {[0, 1, 2, 3, 4].map(() => <span class="star" aria-hidden="true"></span>)}
              <span class="rating">{featured.rating}</span>
            </div>
          )}
          <blockquote>{featured.quote}</blockquote>
          <figcaption><b>{featured.name}</b><span>{featured.role}</span></figcaption>
        </div>
      </figure>
    )}

    <div class="quotes">
      {t.quotes.map((q, i) => (
        <figure class="quote rvu" style={`--d: ${i * 90}ms`}>
          <blockquote>{q.quote}</blockquote>
          <figcaption>
            <img src={q.photo} alt="" width="32" height="32" loading="lazy" />
            <span><b>{q.name}</b><span>{q.role}</span></span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>

  <div class="stats">
    {t.stats.map((s, i) => (
      <div class="stat">
        <Counter value={s.value} suffix={s.suffix} delay={i === 1 ? 150 : i === 2 ? 300 : 0} />
        <span>{s.text}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .testimonials { padding-top: calc(128 * var(--u)); }
  .grid { margin-top: 64px; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 32px; align-items: stretch; }
  .metrics { grid-column: span 4; display: flex; flex-direction: column; gap: 44px; }
  .metrics h2 { max-width: 680px; font-size: calc(34 * var(--u)); line-height: 1.15; font-weight: 600; letter-spacing: -0.02em; color: var(--ink); }
  .measured { font-size: 13px; line-height: 1.5; color: var(--muted); }
  .metric { display: flex; flex-direction: column; gap: 10px; }
  .m-text { font-size: 13px; line-height: 1.45; color: var(--text); }
  .bar { display: block; width: 100%; height: 3px; border-radius: 999px; background: var(--line); overflow: hidden; }
  .bar-f { display: block; height: 3px; border-radius: 999px; background: var(--ink); transform-origin: left center; transition: transform 1.6s cubic-bezier(.16, 1, .3, 1) .25s; }
  :global(.rv-js) .bar:not(.rv-in) .bar-f { transform: scaleX(0); }

  .featured { grid-column: span 4; min-height: 476px; margin: 0; background: var(--ink); border-radius: 24px; overflow: hidden; display: flex; flex-direction: column; color: var(--on-dark); }
  .portrait { flex: 1 1 0; min-height: 180px; width: 100%; object-fit: cover; }
  .f-body { padding: 28px; display: flex; flex-direction: column; gap: 16px; }
  .stars { display: flex; align-items: center; gap: 8px; }
  .star { width: 12px; height: 12px; border-radius: 2px; background: #e8a33d; }
  .rating { font-size: 12px; font-weight: 600; margin-left: 4px; }
  .featured blockquote { margin: 0; font-size: 19px; line-height: 1.3; font-weight: 600; letter-spacing: -0.01em; }
  .featured figcaption { display: flex; flex-direction: column; gap: 2px; }
  .featured figcaption b { font-size: 13px; }
  .featured figcaption span { font-size: 12px; line-height: 1.4; color: var(--on-dark-2); }

  .quotes { grid-column: span 4; display: flex; flex-direction: column; gap: 32px; }
  .no-featured .quotes { grid-column: span 8; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
  .quote { margin: 0; flex: 1 1 0; background: var(--white); border: 1px solid var(--card-line); border-radius: 24px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; gap: 16px; }
  .quote blockquote { margin: 0; font-size: 15px; line-height: 1.4; font-weight: 600; letter-spacing: -0.01em; color: var(--ink); }
  .quote figcaption { display: flex; align-items: center; gap: 12px; }
  .quote img { width: 32px; height: 32px; border-radius: 999px; object-fit: cover; flex-shrink: 0; }
  .quote figcaption > span { display: flex; flex-direction: column; gap: 1px; }
  .quote b { font-size: 13px; font-weight: 600; }
  .quote figcaption > span > span { font-size: 12px; line-height: 1.4; color: var(--muted); }

  .stats { margin-top: 64px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; }
  .stat { display: flex; flex-direction: column; gap: 20px; }
  .stat > span:last-child { max-width: 300px; font-size: 17px; line-height: 1.5; }

  @media (max-width: 819px) {
    .testimonials { padding-top: 64px; display: flex; flex-direction: column; gap: 16px; }
    .grid { margin-top: 0; display: flex; flex-direction: column; gap: 20px; }
    .metrics { gap: 20px; }
    .metrics h2 { font-size: 28px; margin-bottom: 8px; }
    .metric { gap: 8px; }
    .featured { min-height: 0; }
    .portrait { flex: none; height: 180px; }
    .f-body { padding: 24px; gap: 14px; }
    .featured blockquote { font-size: 17px; line-height: 1.35; }
    .quotes, .no-featured .quotes { display: flex; flex-direction: column; gap: 20px; }
    .quote { gap: 14px; }
    .stats { margin-top: 16px; padding-top: 32px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 32px; }
    .stat { gap: 12px; }
    .stat > span:last-child { font-size: 15px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bar-f { transition: none; }
    :global(.rv-js) .bar:not(.rv-in) .bar-f { transform: none; }
  }
</style>
