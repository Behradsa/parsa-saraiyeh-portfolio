---
// Home page footer: page links, contact, legal links and the big wordmark.
import Tm from '../Tm.astro';
import { type Lang, ui, home, url, external, site } from '../../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang).footer;
const work = home(lang).work.items;
const proj = (it: any) => ({ name: it.name, href: it.page ? url(lang, it.page) : external(lang, it.href), newTab: !!it.newTab });
// NikAndish, Nebulox, Snapp!Trip, Carriot, Omid Analyzer, Homano
const projects = [work[4], work[5], work[1], work[0], work[2], work[3]].map(proj);
---
<footer class="footer wrap">
  <div class="top">
    <div class="pages">
      <span class="f-h">{t.pages}</span>
      <div class="lists">
        <ul>
          <li><a href="#top">{t.home}</a></li>
          <li><a href="#work">{t.projects}</a></li>
          <li><a href="#posts">{t.posts}</a></li>
          <li><a href={site.cv} target="_blank" rel="noopener">{t.resume}</a></li>
          <li class="m-only"><a href="#contact">{t.contact}</a></li>
        </ul>
        <ul class="projects">
          {projects.map((p) => <li><a href={p.href} {...(p.newTab ? { target: '_blank', rel: 'noopener' } : {})}>{p.name}</a></li>)}
        </ul>
      </div>
    </div>
    <div class="reach">
      <a class="in" href={site.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><rect x="3" y="3" width="14" height="14" rx="3" /><path d="M6.5 8.5v5M6.5 6.2v.1M10 13.5v-3a1.8 1.8 0 0 1 3.5 0v3" /></svg>
      </a>
      <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
  <div class="legal">
    <span>{t.copyright}<span class="d-only"> · {t.domain}</span></span>
    <span class="legal-links">
      <a href="#top">{t.imprint}</a>
      <a href="#top">{t.privacy}</a>
    </span>
  </div>
  <div class="word" aria-hidden="true">Parsa<Tm /></div>
</footer>

<style>
  .footer { padding-top: 48px; padding-bottom: 48px; min-height: 360px; display: flex; flex-direction: column; }
  .top { min-height: 150px; display: flex; align-items: flex-start; justify-content: space-between; gap: 32px; }
  .pages { display: flex; flex-direction: column; gap: 20px; }
  .f-h { font-size: 13px; font-weight: 600; }
  .lists { display: flex; gap: 64px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .projects { display: grid; grid-auto-flow: column; grid-template-rows: repeat(3, auto); align-content: start; column-gap: 64px; row-gap: 10px; }
  li a { font-size: 13px; color: var(--text); }
  li a:hover { color: var(--ink); }
  .m-only { display: none; }
  .reach { display: flex; flex-direction: column; align-items: flex-end; gap: 20px; }
  .in { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 999px; border: 1px solid var(--card-line); color: var(--ink); }
  .mail { font-size: 17px; font-weight: 600; line-height: 1.5; color: var(--link); }
  .legal { height: 60px; margin-top: 16px; display: flex; align-items: center; justify-content: space-between; gap: 16px; border-top: 1px solid var(--line); font-size: 13px; color: var(--muted); }
  .legal-links { display: flex; gap: 24px; }
  .legal a { color: var(--muted); }
  .word { margin-top: auto; padding-top: 40px; font-size: calc(88 * var(--u)); line-height: 0.92; font-weight: 700; letter-spacing: -0.035em; }

  @media (max-width: 819px) {
    .footer { padding-top: 64px; padding-bottom: 32px; min-height: 0; gap: 28px; }
    .top { flex-direction: column; gap: 28px; min-height: 0; }
    .pages { gap: 16px; align-self: stretch; }
    .lists { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
    .projects { display: flex; }
    .m-only { display: list-item; }
    .reach { flex-direction: row-reverse; align-items: center; justify-content: space-between; align-self: stretch; padding-top: 24px; border-top: 1px solid var(--line); }
    .mail { font-size: 15px; color: var(--ink); }
    .legal { height: auto; margin-top: 0; border-top: 0; font-size: 12px; }
    .legal-links { gap: 16px; }
    .d-only { display: none; }
    .word { padding-top: 0; font-size: 64px; line-height: 0.9; letter-spacing: -0.04em; }
  }
</style>
