---
// "Get in touch" glass pill with the pulsing dot. Hover or tap opens it into email, LinkedIn and CV.
import { type Lang, ui, site } from '../lib/i18n';
interface Props { lang: Lang }
const t = ui(Astro.props.lang).contactCard;
---
<div class="pcc" tabindex="0" aria-label={t.aria}>
  <div class="pcc-card">
    <div class="pcc-stack">
      <div class="pcc-head"><span class="pcc-t">{t.title}</span><span class="pcc-dot" aria-hidden="true"></span></div>
      <div class="pcc-body">
        <div class="pcc-row"><span class="pcc-l">{t.email}</span><a class="pcc-v" href={`mailto:${site.email}`}>{site.email}</a></div>
        <div class="pcc-row"><span class="pcc-l">{t.linkedin}</span><a class="pcc-v" href={site.linkedin} target="_blank" rel="noopener">{site.linkedinHandle}</a></div>
        <div class="pcc-row"><span class="pcc-l">{t.cvLabel}</span><a class="pcc-v" href={site.cv} target="_blank" rel="noopener">{t.cv}</a></div>
      </div>
    </div>
  </div>
</div>

<style>
  .pcc {
    --w: 156px;                     /* closed width; German needs more room */
    position: absolute; left: calc(48 * var(--u)); bottom: calc(48 * var(--u)); z-index: 3;
    width: 290px; height: 52px; display: flex; align-items: flex-end; outline: none;
  }
  :global(:lang(de)) .pcc { --w: 206px; }
  .pcc-card {
    position: absolute; left: 0; bottom: 0; width: var(--w); height: 52px; overflow: hidden; cursor: pointer;
    border-radius: 26px; background: rgba(248, 247, 243, 0.13); border: 1px solid rgba(248, 247, 243, 0.12);
    -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
    transition: height .32s cubic-bezier(.4, 0, .2, 1), width .32s cubic-bezier(.4, 0, .2, 1), border-radius .32s cubic-bezier(.4, 0, .2, 1);
  }
  .pcc-stack { position: absolute; left: 0; right: 0; top: 0; transition: transform .32s cubic-bezier(.4, 0, .2, 1); }
  .pcc-head { height: 52px; padding: 0 22px; display: flex; align-items: center; gap: 12px; transition: opacity .25s ease, filter .25s ease; }
  .pcc-t { font-size: 15px; line-height: 1.3; font-weight: 600; letter-spacing: -0.01em; color: var(--on-dark); white-space: nowrap; }
  .pcc-dot { position: relative; width: 6px; height: 6px; border-radius: 999px; background: var(--accent); flex-shrink: 0; }
  .pcc-dot::after { content: ''; position: absolute; inset: 0; border-radius: 999px; background: var(--accent); animation: ping 1.8s cubic-bezier(0, 0, .2, 1) infinite; }
  @keyframes ping { 0% { transform: scale(1); opacity: .7; } 80%, 100% { transform: scale(3.2); opacity: 0; } }
  .pcc-body { padding: 2px 22px 16px; display: flex; flex-direction: column; gap: 8px; opacity: 0; filter: blur(4px); pointer-events: none; transition: opacity .2s ease, filter .2s ease; }
  .pcc-row { display: flex; flex-direction: column; }
  .pcc-l { font-size: 11px; line-height: 1.35; color: rgba(248, 247, 243, 0.55); }
  .pcc-v { font-size: 14px; line-height: 1.4; font-weight: 600; letter-spacing: -0.01em; color: var(--on-dark); }
  .pcc-v:hover { color: var(--on-dark); text-decoration: underline; text-underline-offset: 3px; }

  .pcc:hover .pcc-card, .pcc:focus-within .pcc-card {
    width: 290px; height: 146px; border-radius: 20px; cursor: default;
    transition: height .55s var(--ease-out), width .55s var(--ease-out), border-radius .55s var(--ease-out);
  }
  .pcc:hover .pcc-stack, .pcc:focus-within .pcc-stack { transform: translateY(-50px); transition: transform .55s var(--ease-out); }
  .pcc:hover .pcc-head, .pcc:focus-within .pcc-head { opacity: 0; filter: blur(4px); transition: opacity .45s ease, filter .45s ease; }
  .pcc:hover .pcc-body, .pcc:focus-within .pcc-body { opacity: 1; filter: blur(0); pointer-events: auto; transition: opacity .3s ease, filter .35s ease; }

  /* phones: sits in the panel's flow and opens to the full width */
  @media (max-width: 819px) {
    .pcc { position: relative; left: auto; bottom: auto; width: auto; height: auto; align-items: flex-start; }
    .pcc-card { position: relative; flex: 0 0 auto; }
    .pcc:hover .pcc-card, .pcc:focus-within .pcc-card { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pcc-card, .pcc-stack, .pcc-head, .pcc-body { transition: none !important; }
    .pcc-dot::after { animation: none; }
  }
</style>
