---
// Every page: <head> (title, share preview, language links), the header and the shared scripts.
// fonts are served from this site (no Google Fonts request); Latin + Latin Extended only
import '@fontsource/inter-tight/latin-400.css';
import '@fontsource/inter-tight/latin-500.css';
import '@fontsource/inter-tight/latin-600.css';
import '@fontsource/inter-tight/latin-700.css';
import '@fontsource/inter-tight/latin-ext-400.css';
import '@fontsource/inter-tight/latin-ext-600.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import { type Lang, ui, absUrl, site } from '../lib/i18n';

interface Props {
  lang: Lang;
  page?: string;          // '' for home, or the case slug
  title: string;
  shareTitle?: string;
  description: string;
  ogImage: string;        // name in /og/, e.g. 'home'
  ogAlt: string;
  headerLabel?: string;   // the small label next to the logo
}
const { lang, page = '', title, shareTitle = title, description, ogImage, ogAlt, headerLabel } = Astro.props;
const t = ui(lang);
const other: Lang = lang === 'en' ? 'de' : 'en';
const img = `${site.domain}/og/${ogImage}.jpg`;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={absUrl(lang, page)} />
  <link rel="alternate" hreflang="en" href={absUrl('en', page)} />
  <link rel="alternate" hreflang="de" href={absUrl('de', page)} />
  <link rel="alternate" hreflang="x-default" href={absUrl('en', page)} />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={shareTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={absUrl(lang, page)} />
  <meta property="og:image" content={img} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogAlt} />
  <meta property="og:locale" content={t.locale} />
  <meta property="og:locale:alternate" content={ui(other).locale} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={shareTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={img} />
  {import.meta.env.BASE_URL !== '/' && <meta name="robots" content="noindex" />}
  <slot name="head" />
</head>
<body>
  <div class="page" id="top">
    <Header lang={lang} page={page} label={headerLabel} />
    <slot />
  </div>
  <script>
    import { initReveal } from '../scripts/reveal';
    import { initSmoothScroll } from '../scripts/smooth-scroll';
    initReveal();
    initSmoothScroll();
  </script>
</body>
</html>
